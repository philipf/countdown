# A last-resort fallback, for a machine with neither the pass entry
# countdown/release-keystore/password nor $COUNTDOWN_KEYSTORE_PASSWORD.
#
# Copy to keystore.properties, which is gitignored, and fill in the password.
# It lives in the worktree, so it goes when the worktree goes — prefer pass,
# which `mise run keystore` writes.
storePassword=

# The keystore is a PKCS12 store, so one password covers the store and the key.
# Only set these to point the build at a keystore other than the default,
# ~/.android-keystores/countdown-release.jks with the key named `countdown`.
#storeFile=/home/you/.android-keystores/countdown-release.jks
#keyAlias=countdown

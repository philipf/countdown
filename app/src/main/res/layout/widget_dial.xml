<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole widget: one ImageView holding the Dial bitmap, per ADR-0002.

  No background, so the Dial sits on the wallpaper rather than on a card. The
  content description is replaced at runtime with what the Dial actually says.
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dial"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/app_name"
    android:scaleType="fitCenter" />

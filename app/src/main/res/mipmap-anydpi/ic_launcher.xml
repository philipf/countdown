<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: three layers, each a vector, so there is one drawing rather
  than one per density bucket. It answers android:roundIcon as well, because a
  launcher cuts an adaptive icon to whatever shape it wants.

  In mipmap-anydpi with no -v26 qualifier and no bitmap beside it, because
  minSdk is 26 and adaptive icons arrived in 26: there is nothing older here to
  fall back to.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

<?xml version="1.0" encoding="utf-8"?>
<!--
  What the launcher is told about the widget.

  There is no android:configure, because one Event app-wide leaves a copy of the
  widget nothing to configure: dropping it shows the Event straight away.

  updatePeriodMillis is 0 — nothing here runs on a timer. The app redraws the
  widget when the Event changes, and midnight is a separate job.

  It is resizable both ways, and 2x2 both as it lands and as small as it goes.
  110dp is two cells on the usual grid; it matches MIN_WIDGET_SIZE_DP in
  WidgetSizing.kt, which is the size the Dial falls back to when a launcher
  reports nothing. There is no maximum: the Dial is drawn again at whatever size
  the widget is dragged to.

  The picker is given a preview twice over. previewLayout is the modern one and
  is drawn at the size the widget will land at, but it is Android 12 and up;
  minSdk is 26, so previewImage is what everything older reads. Both show the
  same drawing of the Dial, because the real one is a bitmap rendered on a
  device and there is no widget yet to render it for.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_dial"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/dial_preview"
    android:previewLayout="@layout/widget_dial_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
